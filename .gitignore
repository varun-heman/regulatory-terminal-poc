# Dependencies and build output
node_modules
dist
*.tsbuildinfo

# Secrets — read server-side only, never committed
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.vscode
.idea
*.swp
*.local

# Logs
*.log
npm-debug.log*

# Client engagement data. The CPC provision tree in src/data/cpc/provisions.json
# and provisionText.json is public law and is committed; a *.local.json beside
# it is a real client's assessments — their documents reviewed, their control
# weaknesses — and must never leave this machine. The app picks one up
# automatically when present and falls back to the committed illustrative set.
src/data/cpc/*.local.json
